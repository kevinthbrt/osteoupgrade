# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=votre_url_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase

# Emailing
RESEND_API_KEY=votre_cle_api_resend
# Doit correspondre à un domaine validé dans Resend (ex: "OsteoUpgrade <no-reply@osteo-upgrade.fr>")
RESEND_FROM="OsteoUpgrade <no-reply@osteo-upgrade.fr>"
NEXT_PUBLIC_RESEND_FROM="OsteoUpgrade <no-reply@osteo-upgrade.fr>"

# Webhook Resend (pour emails entrants)
# Récupérer depuis Resend Dashboard > Inbound > Signing Secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Email admin pour recevoir les emails (parrainage, support, etc.)
ADMIN_EMAIL=admin@osteo-upgrade.fr

# System.io Configuration
SYSTEMIO_API_KEY=votre_cle_api_systemio
SYSTEMIO_API_URL=https://systeme.io/api/v1

# Stripe Configuration
STRIPE_SECRET_KEY=votre_stripe_secret_key
STRIPE_WEBHOOK_SECRET=votre_stripe_webhook_secret

# Stripe Price IDs (Dashboard > Produits > Tarifs). Les montants doivent
# correspondre aux entrées de STRIPE_PLANS dans lib/stripe.ts.
#
# Trois offres, chacune avec un tarif standard mensuel et un tarif Fondateur
# annuel (-50%, réservé aux comptes profiles.is_founding_member).
# Chaque Price porte aussi un lookup_key et un metadata.plan côté Stripe : le
# webhook lit ce metadata en priorité, il reste donc juste même si l'une de ces
# variables est absente. Ces variables servent à créer les sessions de paiement.

# Bundle — OsteoUpgrade + MyOsteoFlow (49,99€/mois, lookup_key premium_monthly)
STRIPE_PRICE_PREMIUM_MONTHLY=votre_price_id_bundle_mensuel
# Bundle Fondateur (299,94€/an, lookup_key bundle_founding_annual)
STRIPE_PRICE_FOUNDING_ANNUAL=votre_price_id_bundle_fondateur

# MyOsteoFlow seul (29,99€/mois, lookup_key osteoflow_monthly)
STRIPE_PRICE_OSTEOFLOW_MONTHLY=votre_price_id_osteoflow_mensuel
# MyOsteoFlow seul — Fondateur (179,94€/an, lookup_key osteoflow_founding_annual)
STRIPE_PRICE_FOUNDING_OSTEOFLOW_ANNUAL=votre_price_id_osteoflow_fondateur

# OsteoUpgrade seul (29,99€/mois, lookup_key osteoupgrade_monthly)
STRIPE_PRICE_OSTEOUPGRADE_MONTHLY=votre_price_id_osteoupgrade_mensuel
# OsteoUpgrade seul — Fondateur (179,94€/an, lookup_key osteoupgrade_founding_annual)
STRIPE_PRICE_FOUNDING_OSTEOUPGRADE_ANNUAL=votre_price_id_osteoupgrade_fondateur

# Stripe Customer Portal Configurations (Dashboard > Réglages > Portail client)
# Configurations historiques, utilisées en repli
STRIPE_PORTAL_CONFIG_ENGAGEMENT=votre_portal_config_engagement
STRIPE_PORTAL_CONFIG_LIBRE=votre_portal_config_libre
#
# Configurations autorisant le CHANGEMENT D'OFFRE, générées par
# `npx tsx scripts/setup-portal-configs.ts`. Deux grilles distinctes : les
# tarifs Fondateur vivent sur les mêmes produits que les tarifs publics, une
# grille unique ferait perdre sa remise à vie à un fondateur qui change d'offre.
# Tant qu'elles sont vides, le portail garde son comportement actuel (pas de
# changement d'offre possible).
STRIPE_PORTAL_CONFIG_PLANS=
STRIPE_PORTAL_CONFIG_PLANS_FOUNDING=

# Vercel Blob Storage (pour les uploads de fichiers)
# Cette variable est automatiquement générée par Vercel si vous activez Blob Storage
# Dashboard Vercel > Storage > Create > Blob > Le token sera automatiquement ajouté
BLOB_READ_WRITE_TOKEN=votre_token_vercel_blob

# Supabase Service Role Key (pour les opérations serveur avec bypass RLS)
# ATTENTION : Ne JAMAIS exposer cette clé côté client !
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Note: Ces variables doivent être configurées dans Vercel
# Dashboard Vercel > Settings > Environment Variables
